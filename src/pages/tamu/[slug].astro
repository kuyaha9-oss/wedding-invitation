---
import Layout from "../../layouts/Layout.astro";
import App from "../../App";
import db from "../../lib/db";
import { getWeddingMeta } from "../../utils/meta";

const slug = Astro.params.slug || "";
const guest = db
  .prepare("SELECT name FROM guests WHERE slug = ?")
  .get(slug) as { name: string } | undefined;

if (!guest) {
  return Astro.redirect("/");
}

const meta = getWeddingMeta();
---

<Layout
  title={`${meta.title} - ${guest.name}`}
  description={`Undangan untuk ${guest.name}. ${meta.description}`}
  image={meta.image}
>
  <App client:only="react" initialGuestName={guest.name} />
</Layout>
